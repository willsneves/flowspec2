{
  "schema": "flowspec/2",
  "flow": "boolean_options_contract",
  "version": "1.0.0",
  "route": {
    "description": "Exercise canonical boolean options across collection and confirmation nodes."
  },
  "config": {
    "identification_required": false
  },
  "domains": {
    "YesNo": {
      "type": "bool",
      "normalize": {
        "affirmation": true
      }
    }
  },
  "slots": {
    "boolean_choice": {
      "domain": "YesNo",
      "required": true
    },
    "summary_confirmed": {
      "domain": "YesNo"
    },
    "simple_confirmed": {
      "domain": "YesNo"
    },
    "hub_confirmed": {
      "domain": "YesNo"
    }
  },
  "path": [
    {
      "step": "collect_boolean_choice",
      "slot": "boolean_choice",
      "prompt": {
        "text": "Choose a boolean value."
      },
      "interactive": {
        "kind": "buttons",
        "field": "boolean_choice_button",
        "from_domain": "YesNo",
        "options_when": [
          {
            "value": false,
            "gate": {
              "eq": [
                "config.identification_required",
                false
              ]
            }
          }
        ]
      }
    },
    {
      "step": "confirm_summary",
      "confirm": "summary_confirmed",
      "prompt": {
        "text": "Confirm the summary?"
      },
      "interactive": {
        "kind": "buttons",
        "field": "summary_confirmation_button",
        "from_domain": "YesNo"
      },
      "on_reject": {
        "end": "Summary rejected."
      }
    },
    {
      "step": "confirm_simple",
      "confirm": "simple_confirmed",
      "prompt": {
        "text": "Confirm this choice?"
      },
      "interactive": {
        "kind": "buttons",
        "field": "simple_confirmation_button",
        "from_domain": "YesNo"
      }
    },
    {
      "step": "confirm_hub",
      "confirm": "hub_confirmed",
      "correctable": true,
      "prompt": {
        "text": "Confirm all values?"
      },
      "interactive": {
        "kind": "buttons",
        "field": "hub_confirmation_button",
        "from_domain": "YesNo"
      }
    },
    {
      "terminal": true
    }
  ],
  "confirm": {
    "step": "confirm_hub",
    "slot": "hub_confirmed",
    "on_confirm": "finish_boolean_options",
    "correctable": [
      "boolean_choice"
    ]
  },
  "terminal": {
    "step": "finish_boolean_options",
    "tool": "open_service_request",
    "idempotent": true,
    "outcomes": {
      "success": {
        "reset_next": true
      },
      "retryable": {
        "preserve_state": true
      },
      "fatal": {
        "reset_next": true
      }
    }
  }
}
