{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prefeitura.rio/flowspec/open-workflow/conversation/1/schema",
  "title": "flowspec2 conversational profile for Open Workflow Specification 1.0.3",
  "description": "Strict schema for the flowspec2 conversational profile only. It is not a validator for arbitrary Open Workflow Specification documents.",
  "type": "object",
  "additionalProperties": false,
  "required": ["document", "do"],
  "properties": {
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dsl", "namespace", "name", "version", "metadata"],
      "properties": {
        "dsl": { "const": "1.0.3" },
        "namespace": { "$ref": "#/$defs/dnsLabel" },
        "name": { "$ref": "#/$defs/dnsLabel" },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["flowspec2"],
          "properties": {
            "flowspec2": {
              "type": "object",
              "additionalProperties": false,
              "required": ["profile", "original_flow_id", "sections"],
              "properties": {
                "profile": {
                  "const": "https://prefeitura.rio/flowspec/open-workflow/conversation/1"
                },
                "original_flow_id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9_]*$"
                },
                "sections": { "$ref": "#/$defs/flowspecSections" }
              }
            }
          }
        }
      }
    },
    "input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {
        "schema": {
          "type": "object",
          "additionalProperties": false,
          "required": ["format", "document"],
          "properties": {
            "format": { "const": "json" },
            "document": { "type": "object" }
          }
        }
      }
    },
    "do": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "minProperties": 1,
        "maxProperties": 1,
        "propertyNames": {
          "pattern": "^path-(0|[1-9][0-9]*)-(slot|confirm|derive|terminal|use|await_external)$"
        },
        "additionalProperties": { "$ref": "#/$defs/profileTask" }
      }
    }
  },
  "$defs": {
    "dnsLabel": {
      "type": "string",
      "pattern": "^[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$"
    },
    "semanticVersion": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[a-zA-Z-][0-9a-zA-Z-]*))*))?(?:\\+([0-9a-zA-Z-]+(?:\\.[0-9a-zA-Z-]+)*))?$"
    },
    "flowspecSections": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "version", "route", "domains"],
      "properties": {
        "schema": { "const": "flowspec/2" },
        "version": { "$ref": "#/$defs/semanticVersion" },
        "service": { "type": "object" },
        "route": { "type": "object" },
        "config": { "type": "object" },
        "entry": { "type": "object" },
        "domains": { "type": "object" },
        "slots": { "type": "object" },
        "uses": { "type": "array" },
        "derive": { "type": "array" },
        "confirm": { "type": "object" },
        "terminal": { "type": "object" },
        "overrides": { "type": "object" },
        "auto_flow": { "type": "object" },
        "capabilities": { "type": "object" }
      }
    },
    "profileTask": {
      "type": "object",
      "additionalProperties": false,
      "required": ["call", "with", "metadata"],
      "properties": {
        "call": {
          "enum": [
            "flowspec2.slot",
            "flowspec2.confirm",
            "flowspec2.derive",
            "flowspec2.terminal",
            "flowspec2.use",
            "flowspec2.await_external"
          ]
        },
        "with": {
          "type": "object",
          "additionalProperties": false,
          "required": ["step"],
          "properties": {
            "step": { "type": "object" }
          }
        },
        "metadata": {
          "type": "object",
          "additionalProperties": false,
          "required": ["path_index"],
          "properties": {
            "path_index": { "type": "integer", "minimum": 0 }
          }
        }
      }
    }
  }
}
